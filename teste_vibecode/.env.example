# Copie para .env. Variáveis do sistema têm prioridade.
DB_BACKEND=sqlite
SQLITE_PATH=data/festa.db

# Exemplo fictício de produção: altere DB_BACKEND para mysql.
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=festa_ifc
MYSQL_USER=festa_app
MYSQL_PASSWORD=senha_ficticia_substitua
# Caminho opcional para o certificado CA do provedor:
MYSQL_SSL_CA=
